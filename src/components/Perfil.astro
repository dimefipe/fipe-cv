---
/**
 * EJEMPLO 1: Import simple y directo desde archivo JavaScript (.js)
 * Importamos solo lo que necesitamos del archivo de datos
 * Este es el método más común y sencillo
 *
 * ARCHIVO DE DATOS: src/data/data-perfil.js
 */
import { perfilProfesional, aptitudes } from '../data/data-perfil.js';
---

<section class="max-w-6xl mx-auto w-full space-y-10 px-4 sm:px-6 lg:px-8">
  <div class="grid gap-8 lg:grid-cols-[1fr_1.2fr] items-stretch">
    <div class="relative h-full overflow-hidden rounded-2xl border border-slate-700/60 bg-slate-900/80 shadow-xl">
      <img
        src="/src/assets/fipe.jpg"
        alt="Felipe Belmar"
        class="h-full w-full object-cover object-top"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent"></div>
      <div class="absolute bottom-4 left-4">
        <span class="rounded-full border border-rose-400/40 bg-slate-900/70 px-3 py-1 text-[10px] uppercase tracking-[0.3em] text-rose-200">
          UI / Web
        </span>
      </div>
    </div>

    <div class="flex flex-col gap-6">
      <article class="rounded-2xl border border-slate-700/60 bg-slate-900/80 p-6 shadow-lg">
        <p class="text-xs uppercase tracking-[0.3em] text-rose-300/80">
          Perfil profesional
        </p>
        <h1 class="mt-3 text-4xl sm:text-5xl font-bold">Felipe Belmar</h1>
        <div class="mt-3 flex flex-wrap gap-2 text-[10px] sm:text-xs uppercase tracking-[0.2em] text-rose-200">
          <span class="rounded-full border border-rose-400/40 bg-slate-900/60 px-3 py-1 sm:px-3 sm:py-1 px-2 py-0.5">
            Desarrollador en formación
          </span>
          <span class="rounded-full border border-slate-700/60 bg-slate-950/60 px-3 py-1 sm:px-3 sm:py-1 px-2 py-0.5">
            Estudiante autodidacta
          </span>
        </div>
        <p class="mt-4 text-slate-300 leading-relaxed">
          {perfilProfesional.descripcion}
        </p>

        <div class="mt-6 flex flex-wrap items-center gap-3">
          <a
            href="https://wa.me/56965069659"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full bg-rose-500 px-5 py-2 text-sm font-semibold text-white shadow-lg shadow-rose-500/30 transition hover:bg-rose-400"
          >
            <i class="ri-whatsapp-line text-lg"></i>
            Hablemos por WhatsApp
          </a>
          <div class="flex items-center gap-2">
            <a
              href="https://www.tiktok.com/@fipe.digital"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-slate-700/60 text-slate-300 transition hover:border-rose-300 hover:text-white"
            >
              <i class="ri-tiktok-fill"></i>
            </a>
            <a
              href="https://www.instagram.com/fipe.digital"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-slate-700/60 text-slate-300 transition hover:border-rose-300 hover:text-white"
            >
              <i class="ri-instagram-fill"></i>
            </a>
          </div>
        </div>
      </article>

    </div>
  </div>

  <article class="rounded-2xl border border-slate-700/60 bg-slate-900/80 p-6 shadow-lg">
    <div class="flex items-center gap-3">
      <div class="flex h-11 w-11 items-center justify-center rounded-full bg-rose-500/15 text-rose-300">
        <i class="ri-brain-2-line text-xl"></i>
      </div>
      <h2 class="text-3xl font-semibold">Habilidades blandas</h2>
    </div>

        <div class="mt-6 grid gap-4 md:grid-cols-2">
          {aptitudes.lista.map(aptitud => (
            <div class="group relative rounded-xl border border-slate-800/70 bg-slate-950/50 p-4">
          <div class="flex items-start justify-between gap-3">
            <span class="text-sm font-semibold text-slate-200 flex items-center gap-2">
              {aptitud.nombre}
              <i class="ri-question-line text-xs text-slate-500"></i>
            </span>
            <span class="text-sm font-semibold text-rose-300">{aptitud.porcentaje}%</span>
          </div>
          <div class="mt-3 h-2 w-full overflow-hidden rounded-full bg-slate-800">
            <div
              class="h-full rounded-full bg-gradient-to-r from-rose-500 to-rose-400"
              style={`width: ${aptitud.porcentaje}%`}
            ></div>
          </div>
              <div class="pointer-events-none absolute left-1/2 bottom-full z-10 mb-3 w-72 -translate-x-1/2 rounded-xl border border-slate-700 bg-slate-950 p-4 text-xs text-slate-300 opacity-0 shadow-2xl transition-all duration-300 group-hover:opacity-100">
                {aptitud.descripcion}
                <div class="absolute left-1/2 bottom-0 h-3 w-3 -translate-x-1/2 translate-y-1/2 rotate-45 border-b border-r border-slate-700 bg-slate-950"></div>
              </div>
            </div>
          ))}
        </div>
  </article>
</section>
