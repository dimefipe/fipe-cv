---
import { contacto } from '../data/data-contacto';

const { informacion, campos, titulo, kicker, descripcion, disponibilidad } = contacto;

const telefonoLink = informacion.telefono ? informacion.telefono.replace(/\s+/g, '') : '';

const camposConValor = campos
  .map((campo) => ({
    ...campo,
    valor: informacion[campo.key],
    enlace:
      campo.tipo === 'email'
        ? `mailto:${informacion.email}`
        : campo.tipo === 'tel'
          ? `tel:${telefonoLink}`
          : campo.tipo === 'enlace'
            ? informacion[campo.key]
            : undefined,
  }))
  .filter((campo) => campo.valor);
---

<section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16 space-y-10">
  <header class="space-y-4">
    <div class="flex flex-wrap items-center gap-3">
      <div class="flex h-11 w-11 items-center justify-center rounded-full bg-rose-500/15 text-rose-300">
        <i class="ri-contacts-book-2-line text-xl"></i>
      </div>
      <div>
        <p class="text-xs uppercase tracking-[0.3em] text-rose-300/80">{kicker}</p>
        <h1 class="text-4xl sm:text-5xl font-bold leading-tight text-balance">{titulo}</h1>
      </div>
    </div>
    <p class="max-w-2xl text-slate-300">
      {descripcion}
    </p>
  </header>

  <div class="grid gap-6 lg:grid-cols-[1.35fr_0.9fr] lg:items-start">
    <div class="grid gap-4 sm:grid-cols-2">
      {camposConValor.map((campo) => (
        <article class="group rounded-2xl border border-slate-700/60 bg-slate-900/80 p-5 shadow-lg transition hover:border-rose-400/60">
          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-rose-500/15 text-rose-300">
              <i class={campo.icono}></i>
            </div>
            <h3 class="text-base font-semibold">{campo.titulo}</h3>
          </div>
          <div class="mt-3 text-sm text-slate-300 break-words">
            {campo.tipo === 'texto' ? (
              <p>{campo.valor}</p>
            ) : (
              <a
                href={campo.enlace}
                target={campo.tipo === 'enlace' ? '_blank' : undefined}
                rel={campo.tipo === 'enlace' ? 'noopener noreferrer' : undefined}
                class="inline-flex items-center gap-2 text-slate-200 transition-colors group-hover:text-rose-300"
              >
                {campo.label ?? campo.valor}
                <i class="ri-external-link-line"></i>
              </a>
            )}
          </div>
        </article>
      ))}
    </div>

    <aside class="rounded-2xl border border-slate-700/60 bg-gradient-to-br from-slate-900/90 via-slate-900/80 to-slate-800/80 p-6 shadow-lg lg:self-start">
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-full bg-rose-500/15 text-rose-200">
          <i class="ri-calendar-check-line"></i>
        </div>
        <h2 class="text-2xl font-semibold">{disponibilidad.titulo}</h2>
      </div>
      <p class="mt-4 text-slate-300">{informacion.disponibilidad}</p>
      {informacion.email && (
        <a
          href={`mailto:${informacion.email}`}
          class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-full border border-rose-400/40 bg-rose-500/10 px-4 py-2 text-sm font-semibold text-rose-100 transition hover:border-rose-300 hover:bg-rose-500/20"
        >
          {disponibilidad.ctaLabel}
          <i class={disponibilidad.ctaIcon}></i>
        </a>
      )}
    </aside>
  </div>
</section>
