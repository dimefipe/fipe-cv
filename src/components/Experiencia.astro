---
/**
 * Experiencia desde Markdown para demostrar frontmatter.
 * ARCHIVO DE DATOS: src/data/data-experiencia.md
 */
const experienciaData = await import('../data/data-experiencia.md');

const {
  trabajos,
  interesProfesional,
  idiomas,
  cierre,
  titulo,
  kicker,
  statsLabel,
} = experienciaData.frontmatter;

const jobIcons = [
  'ri-pencil-ruler-2-line',
  'ri-graduation-cap-line',
  'ri-wordpress-line',
];

const totalResponsabilidades = trabajos.reduce(
  (acc: number, trabajo: any) => acc + trabajo.responsabilidades.length,
  0
);
---

<section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16 space-y-12">
  <header class="space-y-4">
    <div class="flex flex-wrap items-center gap-3">
      <div class="flex h-11 w-11 items-center justify-center rounded-full bg-rose-500/15 text-rose-300">
        <i class="ri-briefcase-4-line text-xl"></i>
      </div>
      <div>
        <p class="text-xs uppercase tracking-[0.3em] text-rose-300/80">
          {kicker}
        </p>
        <h1 class="text-4xl sm:text-5xl font-bold">{titulo}</h1>
      </div>
    </div>
    <p class="text-slate-300">
      {statsLabel}:
      <span class="font-semibold text-rose-300">{totalResponsabilidades}</span>
    </p>
  </header>

  <div class="grid gap-6">
    {trabajos.map((trabajo: any, index: number) => (
      <article class="rounded-2xl border border-slate-700/60 bg-slate-900/80 p-6 shadow-lg">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div class="flex items-start gap-4">
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-rose-500/15 text-rose-200">
              <i class={jobIcons[index] ?? 'ri-briefcase-line'}></i>
            </div>
            <div>
              <h2 class="text-2xl font-semibold">{trabajo.cargo}</h2>
              {trabajo.empresa && (
                <p class="text-sm text-slate-400">{trabajo.empresa}</p>
              )}
            </div>
          </div>
          <div class="flex flex-wrap items-center gap-2 text-xs uppercase tracking-[0.2em] text-slate-300">
            <span class="rounded-full border border-rose-400/40 bg-slate-900/60 px-3 py-1">
              {trabajo.modalidad}
            </span>
            {trabajo.periodo && (
              <span class="rounded-full border border-slate-700/60 bg-slate-950/60 px-3 py-1">
                {trabajo.periodo}
              </span>
            )}
          </div>
        </div>
        <ul class="mt-4 grid gap-3 text-sm text-slate-300 sm:grid-cols-2">
          {trabajo.responsabilidades.map((resp: string) => (
            <li class="flex min-w-0 items-start gap-2">
              <i class="ri-check-line mt-0.5 text-rose-400"></i>
              <span class="break-words">{resp}</span>
            </li>
          ))}
        </ul>
      </article>
    ))}
  </div>

  <div class="grid gap-6 lg:grid-cols-[1.25fr_1fr]">
    <section class="rounded-2xl border border-slate-700/60 bg-slate-900/80 p-6">
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-full bg-rose-500/15 text-rose-200">
          <i class="ri-focus-2-line"></i>
        </div>
        <h3 class="text-2xl font-semibold">{interesProfesional.titulo}</h3>
      </div>
      <ul class="mt-4 space-y-3 text-sm text-slate-300">
        {interesProfesional.intereses.map((interes: string) => (
          <li class="flex items-start gap-2">
            <i class="ri-arrow-right-s-line mt-0.5 text-rose-400"></i>
            <span class="break-words">{interes}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="rounded-2xl border border-slate-700/60 bg-slate-900/80 p-6">
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-full bg-rose-500/15 text-rose-200">
          <i class="ri-global-line"></i>
        </div>
        <h3 class="text-2xl font-semibold">{idiomas.titulo}</h3>
      </div>
      <div class="mt-4 grid gap-3">
        {idiomas.lista.map((item: any) => (
          <div class="flex items-center justify-between rounded-xl border border-slate-800/70 bg-slate-950/60 px-4 py-3">
            <div class="flex items-center gap-2 text-slate-200">
              <i class="ri-flag-2-line text-rose-300"></i>
              <span class="font-semibold">{item.idioma}</span>
            </div>
            <span class="text-xs uppercase tracking-[0.2em] text-slate-400">
              {item.nivel}
            </span>
          </div>
        ))}
      </div>
    </section>
  </div>

  <section class="rounded-2xl border border-slate-700/60 bg-gradient-to-br from-slate-900/90 via-slate-900/80 to-slate-800/80 p-6">
    <div class="flex items-center gap-3">
      <div class="flex h-10 w-10 items-center justify-center rounded-full bg-rose-500/15 text-rose-200">
        <i class="ri-lightbulb-line"></i>
      </div>
      <h3 class="text-2xl font-semibold">{cierre.titulo}</h3>
    </div>
    <p class="mt-4 text-slate-300 leading-relaxed">{cierre.texto}</p>
  </section>
</section>
